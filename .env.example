LLM_BASE_URL=https://llmapi.sanattudu.tech/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=auto
EMBEDDING_MODEL=bge-m3

# Chroma server connection. Locally (no Docker), run your own Chroma
# server first, e.g.: docker run -p 8001:8000 chromadb/chroma
# docker-compose.yml overrides these to CHROMA_HOST=chroma, CHROMA_PORT=8000.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Where ingest.py's manifest.json lives. docker-compose.yml overrides this
# to /data (a dedicated volume shared between the api and ingest containers).
MANIFEST_DIR=chroma_db

# How many chunks go into one embeddings API call during ingestion, and how
# many such batches run concurrently (concurrency isn't acted on yet - the
# setting exists for later tuning).
EMBED_BATCH_SIZE=32
EMBED_CONCURRENCY=1
